<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcher_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".main.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:titleTextColor="?attr/colorOnSurface" />

    <View
        android:layout_width="20dp"
        android:layout_height="60dp"/>

    <ImageView
        android:id="@+id/launcher_mainicon"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_minima"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="50dp"
        android:paddingBottom="30dp"
        android:text="Welcome to Minima"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/launcher_button_newwallet"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="New Wallet"/>

    <View
        android:layout_width="20dp"
        android:layout_height="@dimen/spacing_medium"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/launcher_button_restore"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Restore Wallet"/>

</LinearLayout>