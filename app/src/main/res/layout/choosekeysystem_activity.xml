<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcher_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".main.MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        app:titleTextColor="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <View
        android:layout_width="20dp"
        android:layout_height="40dp"/>

    <ImageView
        android:id="@+id/launcher_mainicon"
        android:src="@drawable/ic_minima"
        android:layout_width="140dp"
        android:layout_height="140dp"/>

    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="30dp"
        android:paddingBottom="10dp"
        android:textSize="20dp"
        android:textStyle="bold"
        android:text="Welcome to Minima"/>

    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="0dp"
        android:textSize="18dp"
        android:text="Choose your base keys system\n\nWe recommend the NEW System\n"/>

    <TextView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="0dp"
        android:paddingBottom="50dp"
        android:textSize="14dp"
        android:text="( Legacy for old Minima and Web Wallet seeds )"/>

    <Button
        android:id="@+id/launcher_button_newsystem"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="New System"/>

    <View
        android:layout_width="20dp"
        android:layout_height="20dp"/>

    <Button
        android:id="@+id/launcher_button_legacy"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Legacy"/>

</LinearLayout>